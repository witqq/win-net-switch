<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>WinNetSwitch-Setup</AssemblyName>
    <RootNamespace>WinNetSwitch.Setup</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WinNetSwitch.Windows/WinNetSwitch.Windows.csproj" />
    <EmbeddedResource
      Include="$(PayloadPath)"
      LogicalName="WinNetSwitch.Payload.exe"
      Condition="'$(PayloadPath)' != '' and Exists('$(PayloadPath)')" />
  </ItemGroup>
</Project>
