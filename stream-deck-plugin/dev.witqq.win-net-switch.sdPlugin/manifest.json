{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "WinNetSwitch",
  "Version": "1.0.1.0",
  "Author": "witqq",
  "Description": "Control physical Windows network adapters from Stream Deck. Requires the separately installed WinNetSwitch companion application.",
  "UUID": "dev.witqq.win-net-switch",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "CodePath": "bin/plugin.js",
  "Icon": "imgs/plugin/marketplace",
  "Category": "WinNetSwitch",
  "CategoryIcon": "imgs/plugin/category",
  "URL": "https://github.com/witqq/win-net-switch",
  "SupportURL": "https://github.com/witqq/win-net-switch/issues",
  "Actions": [
    {
      "Name": "Adapter On/Off",
      "UUID": "dev.witqq.win-net-switch.toggle-adapter",
      "Icon": "imgs/actions/toggle/icon",
      "Tooltip": "Turn one selected physical network adapter on or off without changing the others.",
      "PropertyInspectorPath": "ui/toggle-adapter.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/toggle/key-off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/toggle/key-on",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Cycle Adapters",
      "UUID": "dev.witqq.win-net-switch.cycle-adapters",
      "Icon": "imgs/actions/cycle/icon",
      "Tooltip": "Enable only the next physical network adapter, wrapping around after the last adapter.",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/cycle/key",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}