{
  "name": "win-net-switch-stream-deck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "prepackage": "npm run build",
    "package": "streamdeck pack dev.witqq.win-net-switch.sdPlugin --output ../artifacts/stream-deck --force",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "streamdeck validate dev.witqq.win-net-switch.sdPlugin",
    "watch": "rolldown -c rolldown.config.ts -w"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2",
    "@elgato/utils": "0.6.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.9.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.3",
    "rolldown": "1.2.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
